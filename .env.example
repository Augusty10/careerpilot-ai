# CareerPilot AI - Environment Configuration Template

# Database Configuration
MONGO_URI=mongodb://localhost:27017/careerpilot_db
DB_NAME=careerpilot_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_for_production
JWT_EXPIRY_MINUTES=60

# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:5173

# Server Settings
PORT=5000
FLASK_DEBUG=True

# Module 2: AI Resume Extraction Configuration
# Set AI_MOCK_MODE=true for testing without an API key
AI_MOCK_MODE=true
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
