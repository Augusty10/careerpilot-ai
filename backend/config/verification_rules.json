  "job_suspicious_patterns": [
    {
      "code": "FEE_REQUEST",
      "severity": "high",
      "category": "financial_fraud",
      "regex": "(?:registration|security|processing|training|interview|uniform|laptop|kit|id\\s*card|badge|background\\s*check)\\s*(?:fee|charges?|deposit|amount|cost|payment|money)|(?:pay|deposit|transfer|send)\\s*(?:₹|rs\\.?|inr|\\$|usd)?\\s*\\d+(?:\\s*(?:refundable|non-refundable))?\\s*(?:fee|deposit|charges?)?|(?:refundable\\s*(?:security\\s*)?deposit)|(?:training\\s*cum\\s*placement\\s*charges?)",
      "message": "Posting requests upfront payment, registration fee, or security deposit. Legitimate employers NEVER charge fees to candidates."
    },
    {
      "code": "IDENTITY_THEFT_REQUEST",
      "severity": "high",
      "category": "identity_theft",
      "regex": "(?:send|share|upload|provide)\\s*(?:your\\s*)?(?:otp|one\\s*time\\s*password|bank\\s*(?:account|details|credentials|login|password)|(?:debit|credit)\\s*card\\s*(?:number|cvv|pin)|net\\s*banking\\s*password|aadhaar\\s*(?:card\\s*)?(?:scan|photo|copy|otp)\\s*upfront|pan\\s*card\\s*(?:copy|scan)\\s*before\\s*interview)",
      "message": "Posting requests sensitive identity or financial credentials (OTP, bank details, card PIN/CVV, Aadhaar/PAN upfront)."
    },
    {
      "code": "UNOFFICIAL_COMMUNICATION_CHANNEL",
      "severity": "high",
      "category": "informal_channel",
      "regex": "(?:contact|apply|message|dm|ping|chat|send\\s*(?:cv|resume))\\s*(?:only\\s*)?(?:on|via|through)\\s*(?:telegram|whatsapp|wa\\.me|t\\.me)|(?:join\\s*(?:our\\s*)?telegram\\s*(?:channel|group)\\s*(?:for|to)\\s*(?:interview|job|apply))",
      "message": "Directs candidate to apply or interview exclusively via Telegram or WhatsApp instead of official company channels."
    },
    {
      "code": "UNREALISTIC_SALARY_OR_JOB_GUARANTEE",
      "severity": "high",
      "category": "unrealistic_promise",
      "regex": "(?:earn|make)\\s*(?:up\\s*to\\s*)?(?:₹|rs\\.?|inr)?\\s*(?:[1-9]\\d?|50|100)\\s*(?:lakhs?|lpa)\\s*(?:per\\s*month|monthly|without\\s*skills|without\\s*experience|sitting\\s*at\\s*home)|(?:100%|guaranteed)\\s*(?:placement|job\\s*guarantee|selection\\s*without\\s*(?:exam|interview|test))",
      "message": "Promises unrealistic compensation or 100% job guarantee without rigorous selection or skills evaluation."
    },
    {
      "code": "WFH_NO_INTERVIEW_IMMEDIATE_JOINING",
      "severity": "medium",
      "category": "suspicious_urgency",
      "regex": "(?:work\\s*from\\s*home|wfh)\\s*(?:with\\s*)?(?:no\\s*interview|direct\\s*joining|immediate\\s*appointment\\s*letter\\s*without\\s*interview|data\\s*entry\\s*typing\\s*no\\s*test)",
      "message": "Offers immediate hiring or appointment letters with zero interview or technical evaluation."
    },
    {
      "code": "URGENCY_PRESSURE_LANGUAGE",
      "severity": "low",
      "category": "pressure_tactics",
      "regex": "(?:hurry\\s*up|only\\s*(?:[1-5]|few)\\s*seats?\\s*left|immediate\\s*deposit\\s*required\\s*to\\s*reserve|offer\\s*expires\\s*in\\s*(?:[1-9]|1[0-2])\\s*hours?)",
      "message": "Uses artificial urgency or pressure tactics common in recruitment solicitations."
    }
  ]
}
